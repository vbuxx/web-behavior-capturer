{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wbc.local/schema/visual-redaction-policy-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selectors", "maskColor"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "selectors": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "maskColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
