{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wbc.local/schema/evaluation-task-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "tasks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "starterPath", "referencePath", "groundTruthPath", "captureRecipeId", "scenarioIds", "evidenceAllowlist"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["supported", "partial", "unknown", "unsupported"] },
        "starterPath": { "type": "string", "minLength": 1 },
        "referencePath": { "type": "string", "minLength": 1 },
        "groundTruthPath": { "type": "string", "minLength": 1 },
        "captureRecipeId": { "type": "string", "minLength": 1 },
        "behaviorId": { "type": "string", "minLength": 1 },
        "scenarioIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceAllowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshot", "trace", "wbc"],
          "properties": {
            "screenshot": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "trace": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "wbc": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
