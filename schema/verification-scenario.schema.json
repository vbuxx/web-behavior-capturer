{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wbc.local/schema/verification-scenario-1.0.0.json",
  "title": "WBC Verification Scenario Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "viewport", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "suiteId": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "behaviorId", "kind", "parameters"],
        "properties": {
          "scenarioId": { "type": "string", "minLength": 1 },
          "behaviorId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["hover", "css_animation", "interrupted_transition", "scroll_reveal", "gsap_scrub"] },
          "parameters": { "type": "object" }
        }
      }
    }
  }
}
