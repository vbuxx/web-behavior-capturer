{
  "name": "website-behavior-capture",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local capture and verification engine for Website Behavior Capture",
  "scripts": {
    "build": "tsc --noEmit",
    "capture": "tsx src/cli.ts capture",
    "capture-start": "tsx src/cli.ts capture-start",
    "capture-status": "tsx src/cli.ts capture-status",
    "capture-stop": "tsx src/cli.ts capture-stop",
    "capture-export": "tsx src/cli.ts capture-export",
    "inspect": "tsx src/cli.ts inspect",
    "query": "tsx src/cli.ts query",
    "evidence": "tsx src/cli.ts evidence",
    "behavior-list": "tsx src/cli.ts behavior-list",
    "behavior-get": "tsx src/cli.ts behavior-get",
    "evidence-get": "tsx src/cli.ts evidence-get",
    "review": "tsx src/cli.ts review",
    "benchmark": "tsx src/cli.ts benchmark",
    "evaluate": "tsx src/cli.ts evaluate",
    "benchmark:synthetic": "tsx src/cli.ts benchmark --synthetic",
    "benchmark:browser": "tsx src/cli.ts browser-benchmark",
    "benchmark:capture": "tsx src/cli.ts capture-benchmark",
    "benchmark:reliability": "tsx src/cli.ts reliability-benchmark",
    "benchmark:crash": "tsx src/cli.ts crash-benchmark",
    "cleanup:staging": "tsx src/cli.ts cleanup-staging",
    "benchmark:failure": "tsx src/cli.ts failure-benchmark",
    "benchmark:corruption": "tsx src/cli.ts corruption-benchmark",
    "rotate:package": "tsx src/cli.ts rotate-package",
    "benchmark:quota": "tsx src/cli.ts quota-benchmark",
    "prune:archives": "tsx src/cli.ts prune-archives",
    "cleanup:rotation": "tsx src/cli.ts cleanup-rotation",
    "recover:rotation": "tsx src/cli.ts rotation-recover",
    "verify": "tsx src/cli.ts verify",
    "verify:replica": "tsx src/cli.ts verify --target replica",
    "probe": "tsx src/cli.ts probe",
    "probe-run": "tsx src/cli.ts probe-run",
    "replica-verify": "tsx src/cli.ts replica-verify",
    "mcp": "tsx src/mcp-server.ts",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 test/agent-adapter.test.ts test/archive-retention.test.ts test/redaction.test.ts test/rotation-recovery.test.ts test/rotation-staging.test.ts test/staging.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 test/capture-lifecycle.test.ts test/e2e.test.ts test/nested-scroller.test.ts test/open-shadow.test.ts test/review-server.test.ts test/session-service.test.ts test/visual-redaction.test.ts",
    "test:stress": "tsx --test --test-concurrency=1 test/corruption-benchmark.test.ts test/crash-benchmark.test.ts test/failure-benchmark.test.ts test/quota-benchmark.test.ts test/reliability-benchmark.test.ts",
    "test:performance": "tsx --test --test-concurrency=1 test/benchmark.test.ts test/browser-benchmark.test.ts test/capture-benchmark.test.ts",
    "test:endurance": "tsx src/cli.ts endurance-benchmark",
    "test:rc": "pnpm run build && pnpm run test:unit && pnpm run test:browser"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "gsap": "3.13.0",
    "playwright": "1.55.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.19.0"
}
